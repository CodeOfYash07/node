<!DOCTYPE html>
<html lang="en">

<head>
    <title>Edit Task</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background-color: #e0e5ec;
        min-height: 100vh;
        padding: 50px 0;
        font-family: 'Roboto', sans-serif;
        color: #34495e;
    }

    .card-box {
        background: #e0e5ec;
        border-radius: 20px;
        padding: 50px;
        max-width: 550px;
        margin: auto;
        box-shadow: 10px 10px 20px #a7aeb8,
                    -10px -10px 20px #ffffff;
    }

    h1 {
        font-weight: 700;
        color: #3d5a80;
        margin-bottom: 40px !important;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        text-shadow: 1px 1px 1px #ffffff;
    }

    .form-label {
        font-weight: 500;
        margin-bottom: 8px;
        color: #3d5a80;
    }

    .form-control {
        background-color: #e0e5ec;
        border-radius: 12px;
        border: none;
        padding: 15px 20px;
        transition: all 0.3s ease;
        box-shadow: inset 5px 5px 10px #a7aeb8,
                    inset -5px -5px 10px #ffffff;
    }
    
    .form-control:focus {
        background-color: #f0f5fa;
        outline: none;
        box-shadow: inset 4px 4px 8px #a7aeb8,
                    inset -4px -4px 8px #ffffff;
    }

    .btn {
        border-radius: 15px !important;
        font-weight: 600;
        padding: 12px 50px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        border: none;
        transition: all 0.2s ease;
        box-shadow: 6px 6px 12px #a7aeb8,
                    -6px -6px 12px #ffffff;
    }
    
    .btn-primary {
        background-color: #3d5a80;
        color: white;
    }

    .btn-primary:hover {
        background-color: #4b6992;
        box-shadow: 3px 3px 6px #a7aeb8,
                    -3px -3px 6px #ffffff;
        transform: scale(0.99);
    }

    .btn-success {
        background-color: #98c1d9;
        color: #3d5a80;
    }
    
    .btn-success:hover {
        background-color: #aec9db;
        box-shadow: 3px 3px 6px #a7aeb8,
                    -3px -3px 6px #ffffff;
        transform: scale(0.99);
    }

    .text-center {
        margin-top: 25px; 
    }
</style>
</head>

<body>

    <h1 class="text-center mb-4">Edit Task</h1>

    <div class="card-box">

        <form method="POST" action="/edittask">

            <input type="hidden" name="Id" value="<%= task.Id %>">

            <div class="mb-3">
                <label class="form-label">Task</label>
                <input type="text" name="Name" class="form-control" required placeholder="Enter Task..."
                    value="<%= task.Name %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Assign Date</label>
                <input type="date" name="AssignDate" class="form-control" required value="<%= task.AssignDate %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Due Date</label>
                <input type="date" name="DueDate" class="form-control" required value="<%= task.DueDate %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Priority</label>
                <input type="text" name="priority" class="form-control" required placeholder="low, medium, high"
                    value="<%= task.priority %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <input type="text" name="status" class="form-control" required placeholder="pending, completed"
                    value="<%= task.status %>">
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary px-5">Update</button>
            </div>

        </form>

        <div class="text-center mt-3">
            <a href="/" class="btn btn-success px-5">Back to List</a>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>