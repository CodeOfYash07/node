										<h6 class="mb-5 font-14"><%= hobbyItem %></h6>
										<div class="progress mb-20" style="height: 6px;">
											<div class="progress-bar" role="progressbar" style="width: <%= (index + 1) * 25 %>" aria-valuenow="0"
												aria-valuemin="0" aria-valuemax="100"></div>
										</div>
									<% }); %>
								<% } else { %>
									<p class="text-muted">No hobbies listed</p>
								<% } %>
							</div>
