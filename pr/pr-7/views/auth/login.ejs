<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Login</title>

    <link href="/css/app.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <!-- Toastify CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

    <style>
        .form-section {
            display: none;
        }

        .active-section {
            display: block;
        }

        .card {
            border-radius: 12px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .btn-info {
            background-color: #222e3c;
            border-color: #222e3c;
            color: white;
        }
    </style>
</head>

<body>
    <main class="d-flex w-100">
        <div class="container d-flex flex-column">
            <div class="row vh-100">
                <div class="col-sm-10 col-md-8 col-lg-6 col-xl-5 mx-auto d-table h-100">
                    <div class="d-table-cell align-middle">

                        <div class="text-center mt-4">
                            <h1 class="h2" id="header-title">Welcome back!</h1>
                            <p class="lead" id="header-subtitle">Sign in to your account</p>
                        </div>

                        <div class="card">
                            <div class="card-body">
                                <div class="m-sm-3">

                                    <div id="login-section" class="form-section active-section">
                                        <form action="/login" method="POST">
                                            <div class="mb-3">
                                                <label class="form-label">Email</label>
                                                <input class="form-control form-control-lg" type="email" name="email"
                                                    placeholder="Enter your email" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Password</label>
                                                <input class="form-control form-control-lg" type="password"
                                                    name="password" placeholder="Enter your password" required />
                                            </div>

                                            <div class="d-grid gap-2 mt-4">
                                                <button type="submit" class="btn btn-lg btn-info">Login</button>
                                                <button type="button" class="btn btn-lg btn-light"
                                                    onclick="toggleForm('forgot')">Forgot Password?</button>
                                            </div>
                                        </form>
                                    </div>

                                    <div id="forgot-section" class="form-section">
                                        <form action="/verify-email" method="POST">
                                            <div class="mb-3">
                                                <label class="form-label">Reset Email</label>
                                                <input class="form-control form-control-lg" type="email" name="email"
                                                    placeholder="Enter your registered email" required />
                                                <small class="text-muted">Send Otp In This Email.</small>
                                            </div>

                                            <div class="d-grid gap-2 mt-4">
                                                <button type="submit" class="btn btn-lg btn-primary">Send OTP</button>
                                                <button type="button" class="btn btn-lg btn-light"
                                                    onclick="toggleForm('login')">Back to Login</button>
                                            </div>
                                        </form>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Toastify JS -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    
    <script>
        function showToast(message, type = 'success') {
            const colors = {
                success: 'linear-gradient(to right, #00b09b, #96c93d)',
                error: 'linear-gradient(to right, #ff5f6d, #ffc371)',
                warning: 'linear-gradient(to right, #f093fb, #f5576c)',
                info: 'linear-gradient(to right, #4facfe, #00f2fe)'
            };
            
            Toastify({
                text: message,
                duration: 4000,
                close: true,
                gravity: "top",
                position: "right",
                stopOnFocus: true,
                style: {
                    background: colors[type] || colors.success,
                    borderRadius: "8px",
                    fontSize: "14px",
                    fontWeight: "500"
                }
            }).showToast();
        }
        
        <% if (typeof success !== 'undefined' && success.length > 0) { %>
            showToast('<%= success %>', 'success');
        <% } %>
        
        <% if (typeof error !== 'undefined' && error.length > 0) { %>
            showToast('<%= error %>', 'error');
        <% } %>
        
        <% if (typeof warning !== 'undefined' && warning.length > 0) { %>
            showToast('<%= warning %>', 'warning');
        <% } %>
        
        <% if (typeof info !== 'undefined' && info.length > 0) { %>
            showToast('<%= info %>', 'info');
        <% } %>
    </script>

    <script>
        /**
         * Ye function forms ke beech toggle karta hai
         * @param {string} mode - 'forgot' ya 'login'
         */
        function toggleForm(mode) {
            const loginSec = document.getElementById('login-section');
            const forgotSec = document.getElementById('forgot-section');
            const title = document.getElementById('header-title');
            const subtitle = document.getElementById('header-subtitle');

            if (mode === 'forgot') {
                loginSec.classList.remove('active-section');
                forgotSec.classList.add('active-section');
                title.innerText = "Reset Password";
                subtitle.innerText = "Enter email to receive OTP";
            } else {
                forgotSec.classList.remove('active-section');
                loginSec.classList.add('active-section');
                title.innerText = "Welcome back!";
                subtitle.innerText = "Sign in to your account";
            }
        }
    </script>
</body>

</html>