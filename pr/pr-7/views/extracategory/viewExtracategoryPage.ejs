        <main class="content">
            <div class="container-fluid p-0">
                <!-- Page Header -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h3 class="mb-0"><strong>Extra Category</strong> Management</h3>
                            <a href="/extraCategory/addExtraCategoryPage" class="btn btn-primary">
                                <i data-feather="plus"></i> Add New Extra Category
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Search Bar -->
                <div class="row mb-4">
                    <div class="col-md-12">
                        <div class="input-group">
                            <input type="text" class="form-control" id="search-input"
                                placeholder="Search by extra-category, category or sub-category..." aria-label="Search"
                                aria-describedby="search-btn"
                                style="border-radius: 0.25rem 0 0 0.25rem; border-right: none;">
                            <button class="btn btn-outline-primary" type="button" id="search-btn">
                                <i data-feather="search"></i> Search
                            </button>
                            <button class="btn btn-outline-secondary" type="button" id="clear-search"
                                style="display: none; border-radius: 0 0.25rem 0.25rem 0;">
                                <i data-feather="x"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Category Cards Grid -->
                <div class="row">
                    <div class="col-12">
                        <div class="category-grid" id="category-grid">
                            <% allExtraCategory.forEach((exCat)=> { %>
                                <div class="category-card"
                                    data-extra-name="<%= (exCat.extraCategory_name || '').toLowerCase() %>"
                                    data-category-name="<%= (exCat.category_id?.category_name || '').toLowerCase() %>"
                                    data-subcategory-name="<%= (exCat.subcategory_id?.subCategory_name || '').toLowerCase() %>">
                                    <div class="category-img-wrapper">
                                        <% if (exCat.category_id?.category_img) { %>
                                            <img src="/<%= exCat.category_id.category_img %>"
                                                alt="<%= exCat.extraCategory_name %>">
                                            <% } else { %>
                                                <div
                                                    style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; font-size: 48px;">
                                                    📦
                                                </div>
                                                <% } %>
                                    </div>
                                    <div class="category-content">
                                        <div style="flex: 1;">
                                            <h5 class="category-title">
                                                <%= exCat.extraCategory_name %>
                                            </h5>
                                            <p class="category-meta">
                                                📂 <%= exCat.category_id?.category_name || 'N/A' %> • <%=
                                                        exCat.subcategory_id?.subCategory_name || 'N/A' %>
                                            </p>
                                        </div>
                                        <div class="action-menu">
                                            <i class="ri-more-2-fill action-btn"></i>
                                            <div class="action-dropdown">
                                                <a href="/extraCategory/editExtraCategory/<%= exCat._id %>"
                                                    class="edit-btn" style="text-decoration: none; color: inherit;">
                                                    <i class="ri-edit-2-line"></i> <span
                                                        style="color: #333;">Edit</span>
                                                </a>
                                                <a href="/extraCategory/deleteExtraCategory/<%= exCat._id %>"
                                                    class="delete-btn" style="text-decoration: none; color: inherit;">
                                                    <i class="ri-delete-bin-6-line"></i> <span
                                                        style="color: #333;">Delete</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </main>



        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Initialize Feather Icons
                if (typeof feather !== 'undefined') {
                    feather.replace();
                }

                // Search Functionality
                const searchInput = document.getElementById('search-input');
                const searchBtn = document.getElementById('search-btn');
                const clearSearchBtn = document.getElementById('clear-search');
                const categoryGrid = document.getElementById('category-grid');

                function performSearch() {
                    const searchTerm = searchInput.value.toLowerCase().trim();

                    if (searchTerm) {
                        clearSearchBtn.style.display = 'block';

                        const cards = categoryGrid.querySelectorAll('.category-card');
                        let hasResults = false;

                        cards.forEach(card => {
                            const extraName = (card.dataset.extraName || '').toLowerCase();
                            const catName = (card.dataset.categoryName || '').toLowerCase();
                            const subName = (card.dataset.subcategoryName || '').toLowerCase();

                            if (extraName.includes(searchTerm) || catName.includes(searchTerm) || subName.includes(searchTerm)) {
                                card.style.display = '';
                                hasResults = true;
                            } else {
                                card.style.display = 'none';
                            }
                        });

                        if (!hasResults) {
                            if (typeof showNotification === 'function') showNotification('No categories found matching your search', 'warning');
                        }
                    } else {
                        clearSearch();
                    }
                }

                function clearSearch() {
                    searchInput.value = '';
                    clearSearchBtn.style.display = 'none';

                    const cards = categoryGrid.querySelectorAll('.category-card');
                    cards.forEach(card => {
                        card.style.display = '';
                    });
                }

                searchInput.addEventListener('input', performSearch);
                searchBtn.addEventListener('click', performSearch);
                clearSearchBtn.addEventListener('click', clearSearch);

                // Enter key for search
                searchInput.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') {
                        performSearch();
                    }
                });

                // Action Menu Toggle with Positioning
                document.addEventListener('click', function (e) {
                    const actionBtn = e.target.closest('.action-btn');
                    if (actionBtn) {
                        e.stopPropagation();
                        const menu = actionBtn.closest('.action-menu');
                        const dropdown = menu.querySelector('.action-dropdown');
                        menu.classList.toggle('active');

                        // Position the fixed dropdown
                        if (menu.classList.contains('active')) {
                            const rect = actionBtn.getBoundingClientRect();
                            dropdown.style.top = (rect.bottom + 5) + 'px';
                            dropdown.style.left = (rect.right - 110) + 'px';
                        }

                        // Close other menus
                        document.querySelectorAll('.action-menu').forEach(m => {
                            if (m !== menu) {
                                m.classList.remove('active');
                            }
                        });
                    } else {
                        document.querySelectorAll('.action-menu').forEach(m => {
                            m.classList.remove('active');
                        });
                    }
                });

                // Confirm before deleting an extra category
                document.addEventListener('click', function (e) {
                    const del = e.target.closest('.delete-btn');
                    if (del) {
                        const ok = confirm('Are you sure you want to delete this Extra Category? This action cannot be undone.');
                        if (!ok) {
                            e.preventDefault();
                            e.stopPropagation();
                        }
                    }
                });

                // Close sidebar on overlay click
                const overlay = document.getElementById('sidebarOverlay');
                if (overlay) {
                    overlay.addEventListener('click', closeSidebar);
                }

                // Close sidebar on ESC key + close any open action menus
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        closeSidebar();
                        document.querySelectorAll('.action-menu').forEach(m => {
                            m.classList.remove('active');
                            const btn = m.querySelector('.action-btn');
                            const dd = m.querySelector('.action-dropdown');
                            if (btn) btn.setAttribute('aria-expanded', 'false');
                            if (dd) dd.setAttribute('aria-hidden', 'true');
                        });
                    }
                });

                // Add hover effect to cards
                const cards = document.querySelectorAll('.category-card');
                cards.forEach(card => {
                    card.addEventListener('mouseenter', function () {
                        this.style.borderColor = '#0a66c2';
                    });
                    card.addEventListener('mouseleave', function () {
                        this.style.borderColor = '#f0f0f0';
                    });
                });
            });
        </script>

        <%- include('../footer') %>