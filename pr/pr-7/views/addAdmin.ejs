        <main class="content">
            <div class="container-fluid p-0">

                <div class="mb-3">
                    <h1 class="h3 d-inline align-middle">Forms</h1>
                    <a class="badge bg-dark text-white ms-2" href="upgrade-to-pro.html">
                        Add Admins
                    </a>
                </div>
                <div class="row">
                    <div class="col-12 col-lg-12">
                        <form action="/addAdmin" method="post" enctype="multipart/form-data">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">Fill Admin Data</h5>
                                </div>
                                <div class="card-body linkedin-form">

                                    <div class="li-field">
                                        <label>Profile Photo</label>

                                        <div class="upload-box" id="uploadBox">
                                            <i class="ri-upload-cloud-2-line"></i>
                                            <p><strong>Click to upload</strong> or drag & drop</p>
                                            <span>PNG, JPG up to 5MB</span>
                                            <input type="file" id="fileInput" name="profile" hidden>
                                        </div>
                                    </div>


                                    <div class="li-row">
                                        <div class="li-field">
                                            <label>First Name</label>
                                            <input type="text" placeholder="Sujal" name="fname">
                                        </div>
                                        <div class="li-field">
                                            <label>Last Name</label>
                                            <input type="text" placeholder="Kidecha" name="lname">
                                        </div>
                                    </div>

                                    <div class="li-field">
                                        <label>Email Address</label>
                                        <input type="email" placeholder="name@example.com" name="email">
                                    </div>

                                    <div class="li-field">
                                        <label>Password</label>
                                        <input type="password" placeholder="Create password" name="password">
                                    </div>

                                    <div class="li-field">
                                        <label>Contact Number</label>
                                        <input type="number" placeholder="+91 XXXXX XXXXX" name="phone">
                                    </div>

                                    <div class="li-field">
                                        <label>Gender</label>
                                        <div class="li-options">
                                            <label><input type="radio" name="gander" value="Male"> Male</label>
                                            <label><input type="radio" name="gander" value="Female"> Female</label>
                                        </div>
                                    </div>

                                    <div class="li-field">
                                        <label>Hobbies</label>
                                        <div class="li-options">
                                            <label><input type="checkbox" value="Coding" name="hobby"> Coding</label>
                                            <label><input type="checkbox" value="Cricket" name="hobby"> Cricket</label>
                                            <label><input type="checkbox" value="Music" name="hobby"> Music</label>
                                            <label><input type="checkbox" value="Other" name="hobby"> Other</label>
                                        </div>
                                    </div>

                                    <div class="li-field">
                                        <label>City</label>
                                        <select name="city">
                                            <option disabled selected>Select your city</option>
                                            <option>Surat</option>
                                            <option>Ahmedabad</option>
                                            <option>Bharuch</option>
                                            <option>Navsari</option>
                                            <option>Vadodara</option>
                                            <option>Bardoli</option>
                                            <option>Amreli</option>
                                        </select>
                                    </div>

                                    <div class="li-field">
                                        <label>About</label>
                                        <textarea rows="3" placeholder="Tell us about yourself" name="about"></textarea>
                                    </div>

                                    <div class="li-actions">
                                        <button type="submit" class="li-submit">Submit</button>
                                    </div>


                                </div>

                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </main>
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const uploadBox = document.getElementById("uploadBox");
                const fileInput = document.getElementById("fileInput");

                uploadBox.addEventListener("click", () => fileInput.click());

                uploadBox.addEventListener("dragover", e => {
                    e.preventDefault();
                    uploadBox.classList.add("dragging");
                });

                uploadBox.addEventListener("dragleave", () => {
                    uploadBox.classList.remove("dragging");
                });

                uploadBox.addEventListener("drop", e => {
                    e.preventDefault();
                    fileInput.files = e.dataTransfer.files;

                    uploadBox.innerHTML = `
            <i class="ri-image-line"></i>
            <p>${fileInput.files[0].name}</p>
            <span>File selected</span>
        `;
                    uploadBox.classList.remove("dragging");
                });

            });

        </script>
