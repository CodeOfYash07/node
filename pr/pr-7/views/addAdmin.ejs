<%- include('header') %>

    <style>
        .linkedin-form {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .li-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .li-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .li-field label {
            font-size: 13px;
            font-weight: 600;
            color: #1f1f1f;
        }

        .li-field input,
        .li-field select,
        .li-field textarea {
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid #cfd3d7;
            font-size: 14px;
            outline: none;
            transition: all 0.2s ease;
            background: #fff;
        }

        .li-field input:focus,
        .li-field select:focus,
        .li-field textarea:focus {
            border-color: #0a66c2;
            box-shadow: 0 0 0 2px rgba(10, 102, 194, 0.15);
        }

        .li-options {
            display: flex;
            gap: 18px;
            font-size: 14px;
            color: #333;
        }

        .li-options label {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .upload-box {
            border: 2px dashed #cfd3d7;
            border-radius: 10px;
            padding: 26px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #fafbfc;
        }

        .upload-box i {
            font-size: 28px;
            color: #0a66c2;
            margin-bottom: 8px;
        }

        .upload-box p {
            margin: 4px 0;
            font-size: 14px;
        }

        .upload-box span {
            font-size: 12px;
            color: #666;
        }

        .upload-box:hover {
            border-color: #0a66c2;
            background: #f0f7ff;
        }

        .upload-box.dragging {
            border-color: #0a66c2;
            background: #e9f3ff;
        }

        .li-actions {
            display: flex;
            justify-content: flex-end;
            margin-top: 10px;
        }

        .li-submit {
            background: #0a66c2;
            color: #fff;
            border: none;
            padding: 10px 26px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .li-submit:hover {
            background: #004182;
        }

        .li-submit:active {
            transform: scale(0.97);
        }
    </style>

