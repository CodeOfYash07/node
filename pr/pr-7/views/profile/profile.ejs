        <main class="content">
            <div class="container-fluid p-0">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3">
                    <h1 class="h2">Profile</h1>
                    <div>
                        <a class="btn btn-outline-secondary me-2" href="/change-password"><i class="bx bx-lock"></i>
                            Change Password</a>
                        <a class="btn btn-primary" href="/editAdmin/<%= admin._id %>?returnTo=/profile"><i
                                class="bx bx-edit-alt"></i> Edit</a>
                    </div>
                </div>

                <div class="row">
                    <!-- Profile Card -->
                    <div class="col-lg-4 mb-4">
                        <div class="card shadow-sm">
                            <div class="card-body text-center">
                                <div style="width:140px; height:140px; margin:0 auto;">
                                    <img src="<%= admin.profile %>" alt="<%= admin.fname %>" class="rounded-circle"
                                        style="width:100%; height:100%; object-fit:cover; border:4px solid rgba(255,255,255,0.6); box-shadow:0 6px 18px rgba(0,0,0,0.12);" />
                                </div>
                                <h4 class="mt-3 mb-0">
                                    <%= admin.fname %>
                                        <%= admin.lname %>
                                </h4>
                                <p class="text-muted mb-2">Administrator</p>
                                <div class="d-flex justify-content-center gap-2">
                                    <a class="btn btn-sm btn-outline-primary"
                                        href="/editAdmin/<%= admin._id %>?returnTo=/profile"><i
                                            class="bx bx-pencil"></i> Edit Profile</a>
                                    <a class="btn btn-sm btn-outline-secondary" href="#"><i class="bx bx-share-alt"></i>
                                        Share</a>
                                </div>
                            </div>
                            <div class="card-body border-top">
                                <h6 class="text-uppercase small text-muted">About</h6>
                                <p class="mb-2"><i class="bx bx-map me-1"></i> <strong>City:</strong>
                                    <%= admin.city || 'Not specified' %>
                                </p>
                                <p class="mb-2"><i class="bx bx-briefcase me-1"></i> <strong>Role:</strong>
                                    Administrator</p>
                                <% if (admin.hobby) { %>
                                    <p class="mb-2"><i class="bx bx-heart me-1"></i> <strong>Hobbies:</strong>
                                        <%= Array.isArray(admin.hobby) ? admin.hobby.join(', ') : admin.hobby %></p>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Details Card -->
                    <div class="col-lg-8">
                        <div class="card shadow-sm mb-4">
                            <div class="card-body">
                                <h5 class="card-title">Personal Information</h5>
                                <div class="row mt-3">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-muted small">Full Name</label>
                                        <div class="fw-semibold"><%= admin.fname %> <%= admin.lname %></div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-muted small">Email</label>
                                        <div class="fw-semibold"><%= admin.email %></div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-muted small">City</label>
                                        <div class="fw-semibold"><%= admin.city || ' Not specified' %>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Phone</label>
                            <div class="fw-semibold">
                                <%= admin.phone || 'N/A' %>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small">About</label>
                            <p class="text-muted">
                                <%= admin.about || 'No bio added yet.' %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Elsewhere</h5>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bx bx-globe"></i> Website</a>
                        <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bx bxl-twitter"></i> Twitter</a>
                        <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bx bxl-facebook"></i>
                            Facebook</a>
                        <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bx bxl-instagram"></i>
                            Instagram</a>
                        <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bx bxl-linkedin"></i>
                            LinkedIn</a>
                    </div>
                </div>
            </div>
    </div>

    </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof feather !== 'undefined') feather.replace();
        });
    </script>
    </main>

