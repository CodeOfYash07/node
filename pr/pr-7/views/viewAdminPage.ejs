<%- include('header') %>


    <!-- Table Start -->
    <div class="container-fluid vh-100" style="margin-left: 280px; margin-top: 150px;">
        <h4>All Admins</h4>

        <div class="row g-4">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="text-center">
                        <tr>
                            <th>No</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Email</th>
                            <th>Password</th>
                            <th>contact</th>
                            <th>Gender</th>
                            <th>Hobby</th>
                            <th>City</th>
                            <th>About</th>
                            <th>Image</th>
                            <% if (admin.email==="yashkhunt128@gmail.com" ){%>
                                <th colspan="2">Action</th>
                                <%}%>
                        </tr>
                    </thead>
                    <tbody>
                        <% allAdmin.map((admindata, index)=> { %>
                            <tr>
                                <td>
                                    <%= index + 1%>
                                </td>

                                <td>
                                    <%= admindata.fname %>
                                </td>

                                <td>
                                    <%= admindata.lname %>
                                </td>
                                <td>
                                    <%= admindata.email %>
                                </td>
                                <td>
                                    <%= admindata.password %>
                                </td>
                                <td>
                                    <%= admindata.contact %>
                                </td>
                                <td>
                                    <%= admindata.gender %>
                                </td>
                                <td>
                                    <%= admindata.hobby %>
                                </td>
                                <td>
                                    <%= admindata.city %>
                                </td>
                                <td>
                                    <%= admindata.about %>
                                </td>
                                <td>
                                    <img src="<%= admindata.profileimg %>" width="100" alt="">
                                </td>

                                <% if (admin.email==="yashkhunt128@gmail.com" ) { %>
                                    <td>
                                        <a href="/deleteAdmin/<%= admindata._id %>"
                                            class="btn btn-danger btn-sm text-white">
                                            Delete
                                        </a>
                                    </td>
                                    <td>
                                        <a href="/editAdmin/<%= admindata._id %>"
                                            class="btn btn-warning btn-sm text-white">
                                            Edit
                                        </a>
                                    </td>
                                    <% } %>
                            </tr>

                            <% }) %>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
    </div>
    <!-- Table End -->

    <%- include('footer') %>