<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>App Store</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen flex">

<!-- ================= SIDEBAR ================= -->
<aside class="w-64 bg-gray-50 border-r px-4 py-6 hidden md:block">
    <input type="text"
           placeholder="Search"
           class="w-full mb-6 px-3 py-2 rounded-lg border text-sm">

    <nav class="space-y-3 text-sm">
        <div class="font-semibold text-purple-600">▶ Play</div>
        <div class="text-gray-700">Discover</div>
        <div class="text-gray-700">Arcade</div>
        <div class="text-gray-700">Create</div>
        <div class="text-gray-700">Work</div>
        <div class="text-gray-700">Categories</div>
        <div class="text-gray-700">Updates</div>
    </nav>
</aside>

<!-- ================= MAIN ================= -->
<main class="flex-1 overflow-y-auto">

    <!-- HEADER -->
    <header class="bg-white shadow sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold">Play</h1>
            <a href="/Addstore"
               class="text-blue-600 font-semibold">
                + Add Store
            </a>
        </div>
    </header>

    <!-- EMPTY STATE -->
    <% if (!allstores || allstores.length === 0) { %>
        <div class="text-center text-gray-500 py-20">
            No games found in database.<br>
            Please run <b>node seedGames.js</b>
        </div>
    <% } %>

    <!-- ================= GRID ================= -->
    <section class="max-w-7xl mx-auto px-6 py-10">

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">

            <% allstores.forEach(function(app){ %>
            <div class="bg-white rounded-2xl p-4 shadow hover:shadow-md transition">

                <!-- IMAGE -->
                <img src="/uploads/<%= app.storeImage %>"
                     class="w-full aspect-square rounded-2xl object-cover mb-3"
                     onerror="this.src='https://via.placeholder.com/300'">

                <!-- STORE NAME -->
                <h4 class="text-sm font-semibold truncate">
                    <%= app.storeName %>
                </h4>

                <!-- PRICE -->
                <p class="text-sm font-bold text-gray-800 mt-1">
                    <% if (Number(app.storePrice) > 0) { %>
                        ௹ <%= app.storePrice %>
                    <% } else { %>
                        Free
                    <% } %>
                </p>

                <!-- ACTIONS -->
                <div class="flex gap-2 mt-3">
                    <a href="/Editstore/<%= app._id %>"
                       class="flex-1 text-center bg-blue-600 text-white py-1 rounded-full text-xs font-semibold">
                        Edit
                    </a>

                    <a href="/Deletestore/<%= app._id %>"
                       onclick="return confirm('Delete this store?')"
                       class="flex-1 text-center bg-red-500 text-white py-1 rounded-full text-xs font-semibold">
                        Delete
                    </a>
                </div>

            </div>
            <% }) %>

        </div>
    </section>

</main>

</body>
</html>
